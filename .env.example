# Copy to .env at the repository root. Never commit .env.
# URL-encode special characters in the database password.
DATABASE_URL=postgresql+psycopg://sigg_app:CHANGE_ME@localhost:5432/sigg_tcc
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=
APP_ENV=development
# Apply pending migrations before yarn dev/dev:backend for a local PostgreSQL.
# Set false to manage migrations explicitly with yarn db:upgrade.
AUTO_MIGRATE=true
CORS_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
JWT_ACCESS_MINUTES=20
SESSION_IDLE_MINUTES=20
SESSION_MAX_HOURS=12
RESET_CODE_MINUTES=10
CLASS_CODE_DAYS=30
# For multiple workers use shared Redis: redis://localhost:6379/0
RATELIMIT_STORAGE_URI=memory://
# SMTP is required for password recovery. STARTTLS by default.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
SMTP_SSL=false
FRONTEND_URL=http://127.0.0.1:5173
